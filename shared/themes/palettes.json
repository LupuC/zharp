{
  "_readme": [
    "Canonical Zharp color palettes. This file is data, not code, and no app reads",
    "it at runtime: each platform hard-codes the same values in its own source.",
    "Editing this file alone changes nothing that ships. Update the embedded copies",
    "too, then run scripts/check-shared-drift.sh, which fails when they disagree.",
    "Embedded copies: macos/Sources/ZharpCore/Terminal/Palette.swift and",
    "windows/src/Zharp.Core/Terminal/Palette.cs."
  ],
  "version": 1,
  "colorFormat": "RRGGBB, uppercase hex, no leading '#' and no leading '0x'.",
  "indexedPalette": {
    "_note": "Entries 0-15 come from each theme's ansi16. Entries 16-255 are generated and are identical for every theme.",
    "cube": {
      "firstIndex": 16,
      "steps": [0, 95, 135, 175, 215, 255],
      "formula": "index = 16 + r*36 + g*6 + b, color = (steps[r] << 16) | (steps[g] << 8) | steps[b], for r, g, b each 0-5"
    },
    "grayscaleRamp": {
      "firstIndex": 232,
      "count": 24,
      "formula": "index = 232 + i, v = 8 + i*10, color = (v << 16) | (v << 8) | v, for i 0-23"
    }
  },
  "sharedAnsi16": {
    "_note": "Named 16-color sets that more than one theme uses. A theme referring to one carries 'ansi16Ref' instead of its own 'ansi16'.",
    "gitHubLight": [
      "24292F", "CF222E", "116329", "7D4E00", "0969DA", "8250DF", "1B7C8C", "6E7781",
      "57606A", "A40E26", "1A7F37", "633C01", "218BFF", "A475F9", "3192AA", "8C959F"
    ]
  },
