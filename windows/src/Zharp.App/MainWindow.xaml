<Window
    x:Class="Zharp.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zharp.App"
    xmlns:controls="using:Zharp.App.Controls">

    <!-- No scale transforms anywhere: chrome zoom multiplies real metrics
         (ChromeZoom walker + SessionItem bound sizes) so everything re-renders
         crisply; terminals live in TerminalLayer and zoom via font size. -->
    <Grid x:Name="OuterRoot" KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Mostly-opaque neutral wash keeps the backdrop dark grey regardless of
         wallpaper tint, while letting a hint of Mica texture through. Matches the
         terminal surface color so the title bar blends with no seam. -->
    <Grid x:Name="Root" Background="{ThemeResource ChromeWashBrush}">
        <Grid.Resources>
            <ResourceDictionary>
            <!-- Flat inputs: uniform 1px border, no accent underline. These must be
                 overridden at ELEMENT scope - app-level ThemeDictionaries lose to
                 XamlControlsResources' own theme dictionaries. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4DFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33000000" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4D000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="46" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource BarIconBrush}" />
            </Style>
            <Style x:Key="CardCloseButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleIconBrush}" />
            </Style>

            <!-- Sidebar session card (comfortable: two lines) -->
            <DataTemplate x:Key="SessionCardTemplate" x:DataType="local:SessionItem">
                <Grid Padding="10,5" ColumnSpacing="8" Background="Transparent"
                      Opacity="{Binding DragOpacity}"
                      PointerEntered="OnSessionCardPointerEntered" PointerExited="OnSessionCardPointerExited"
                      PointerPressed="OnSessionCardPointerPressed" PointerCanceled="OnSessionCardPointerCanceled">
                    <ToolTipService.ToolTip>
                        <ToolTip Padding="12,10" Placement="Right">
                            <StackPanel Spacing="3" MinWidth="170">
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SessionName}" FontSize="12" Opacity="0.85" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0" Opacity="0.6">
                                    <Grid>
                                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding IconGlyph}"
                                                  FontSize="12" Visibility="{Binding StandardIconVisibility}" />
                                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding AgentGlyph}"
                                                  FontSize="12" Foreground="{Binding AgentBrush}"
                                                  Visibility="{Binding ClaudeIconVisibility}" />
                                    </Grid>
                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- The dot sits outside the chip, not in it: a rounded
                         Border clips its children, and a badge is only a badge
                         when it breaks the edge of the thing it is on. -->
                    <Grid VerticalAlignment="Center">
                        <Border Width="{Binding Z24}" Height="{Binding Z24}" CornerRadius="5"
                                Background="{ThemeResource IconChipBrush}">
                            <Grid>
                                <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding IconGlyph}"
                                          FontSize="{Binding Z16}" Foreground="{ThemeResource BarIconBrush}"
                                          Visibility="{Binding StandardIconVisibility}" />
                                <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding AgentGlyph}"
                                          FontSize="{Binding Z16}" Foreground="{Binding AgentBrush}"
                                          Visibility="{Binding ClaudeIconVisibility}" />
                            </Grid>
                        </Border>
                        <Ellipse Width="8" Height="8" Margin="0,-2,-2,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Fill="{ThemeResource AgentAttentionBrush}"
                                 Stroke="{ThemeResource AgentAttentionRingBrush}" StrokeThickness="1.5"
                                 Visibility="{Binding AttentionVisibility}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <controls:TailTextBlock Text="{Binding DisplayTitle}" FontSize="{Binding Z12}"
                                                EmphasisBold="True" TailFirst="{Binding TitleTailFirst}" />
                        <controls:TailTextBlock Text="{Binding DisplaySubtitle}" FontSize="{Binding Z11}"
                                                Opacity="{Binding SubtitleOpacity}"
                                                TailFirst="{Binding SubtitleTailFirst}"
                                                Tint="{Binding SubtitleTint}"
                                                EmphasisBold="{Binding SubtitleBold}"
                                                Visibility="{Binding SubtitleVisibility}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CardCloseButton}"
                            Opacity="0" VerticalAlignment="Center" Click="OnCloseSessionClick"
                            ToolTipService.ToolTip="Close session">
                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xEB55;" FontSize="{Binding Z14}" />
                    </Button>
                </Grid>
            </DataTemplate>

            <!-- Sidebar session card (compact: single line) -->
            <DataTemplate x:Key="SessionCardCompactTemplate" x:DataType="local:SessionItem">
                <Grid Padding="10,3" ColumnSpacing="8" Background="Transparent"
                      Opacity="{Binding DragOpacity}"
                      PointerEntered="OnSessionCardPointerEntered" PointerExited="OnSessionCardPointerExited"
                      PointerPressed="OnSessionCardPointerPressed" PointerCanceled="OnSessionCardPointerCanceled">
                    <ToolTipService.ToolTip>
                        <ToolTip Padding="12,10" Placement="Right">
                            <StackPanel Spacing="3" MinWidth="170">
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SessionName}" FontSize="12" Opacity="0.85" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0" Opacity="0.6">
                                    <Grid>
                                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding IconGlyph}"
                                                  FontSize="12" Visibility="{Binding StandardIconVisibility}" />
                                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding AgentGlyph}"
                                                  FontSize="12" Foreground="{Binding AgentBrush}"
                                                  Visibility="{Binding ClaudeIconVisibility}" />
                                    </Grid>
                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding IconGlyph}"
                                  FontSize="14" Foreground="{ThemeResource BarIconBrush}"
                                  Visibility="{Binding StandardIconVisibility}" />
                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding AgentGlyph}"
                                  FontSize="14" Foreground="{Binding AgentBrush}"
                                  Visibility="{Binding ClaudeIconVisibility}" />
                        <Ellipse Width="7" Height="7" Margin="0,-2,-4,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Fill="{ThemeResource AgentAttentionBrush}"
                                 Stroke="{ThemeResource AgentAttentionRingBrush}" StrokeThickness="1.5"
                                 Visibility="{Binding AttentionVisibility}" />
                    </Grid>
                    <controls:TailTextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="{Binding Z12}"
                                            TailFirst="{Binding TitleTailFirst}"
                                            VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource CardCloseButton}"
                            Opacity="0" VerticalAlignment="Center" Click="OnCloseSessionClick"
                            ToolTipService.ToolTip="Close session">
                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xEB55;" FontSize="{Binding Z12}" />
                    </Button>
                </Grid>
            </DataTemplate>

            <!-- Horizontal pill tab -->
            <DataTemplate x:Key="SessionPillTemplate" x:DataType="local:SessionItem">
                <Grid Padding="8,0,2,0" ColumnSpacing="6" Height="{Binding Z26}" Background="Transparent"
                      Opacity="{Binding DragOpacity}"
                      PointerEntered="OnSessionCardPointerEntered" PointerExited="OnSessionCardPointerExited"
                      PointerPressed="OnSessionCardPointerPressed" PointerCanceled="OnSessionCardPointerCanceled">
                    <ToolTipService.ToolTip>
                        <ToolTip Padding="12,10" Placement="Bottom">
                            <StackPanel Spacing="3" MinWidth="170">
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SessionName}" FontSize="12" Opacity="0.85" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0" Opacity="0.6">
                                    <Grid>
                                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding IconGlyph}"
                                                  FontSize="12" Visibility="{Binding StandardIconVisibility}" />
                                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding AgentGlyph}"
                                                  FontSize="12" Foreground="{Binding AgentBrush}"
                                                  Visibility="{Binding ClaudeIconVisibility}" />
                                    </Grid>
                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding IconGlyph}" FontSize="15"
                                  Foreground="{ThemeResource BarIconBrush}"
                                  Visibility="{Binding StandardIconVisibility}" />
                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="{Binding AgentGlyph}" FontSize="15"
                                  Foreground="{Binding AgentBrush}"
                                  Visibility="{Binding ClaudeIconVisibility}" />
                        <Ellipse Width="7" Height="7" Margin="0,-2,-4,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Fill="{ThemeResource AgentAttentionBrush}"
                                 Stroke="{ThemeResource AgentAttentionRingBrush}" StrokeThickness="1.5"
                                 Visibility="{Binding AttentionVisibility}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding CompactTitle}" FontSize="{Binding Z12}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="140" />
                    <Button Grid.Column="2" Style="{StaticResource CardCloseButton}"
                            Opacity="0" VerticalAlignment="Center" Click="OnCloseSessionClick">
                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xEB55;" FontSize="{Binding Z13}" />
                    </Button>
                </Grid>
            </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <!-- Sized at runtime to match the system caption-button height exactly. -->
            <RowDefinition x:Name="TitleBarRow" Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Title bar ================= -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="Transparent" SizeChanged="OnTitleBarSizeChanged"
              BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="LeftTitleButtons" Orientation="Horizontal" Spacing="2"
                        Margin="7,0,0,0" VerticalAlignment="Center" SizeChanged="OnTitleBarSizeChanged">
                <Button x:Name="SidebarToggle" Style="{StaticResource BarIconButton}" AutomationProperties.Name="Toggle tab panel"
                        Click="OnSidebarToggleClick" ToolTipService.ToolTip="Toggle tab panel">
                    <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xEADA;" FontSize="18" />
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource BarIconButton}" AutomationProperties.Name="Settings"
                        Click="OnSettingsClick" ToolTipService.ToolTip="Settings">
                    <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xEB20;" FontSize="18" />
                </Button>
                <Button x:Name="SearchButton" Style="{StaticResource BarIconButton}" AutomationProperties.Name="Search"
                        Click="OnSearchClick" ToolTipService.ToolTip="Search">
                    <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xEB1C;" FontSize="18" />
                </Button>
            </StackPanel>

            <!-- Update badge (+ room for the future account/login chip). -->
            <StackPanel x:Name="RightTitleIcons" Grid.Column="4" Orientation="Horizontal" Spacing="2"
                        VerticalAlignment="Center" SizeChanged="OnTitleBarSizeChanged">
                <StackPanel.Resources>
                    <!-- Declared on the PARENT: a ThemeResource attribute that
                         points into the same element's own dictionary crashes
                         InitializeComponent (parsed before the dictionary). -->
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="UpdateBadgeBackground" Color="#26E0524D" />
                                <SolidColorBrush x:Key="UpdateBadgeForeground" Color="#EE9C95" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="UpdateBadgeBackground" Color="#1CC4433B" />
                                <SolidColorBrush x:Key="UpdateBadgeForeground" Color="#A8423B" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </StackPanel.Resources>
                <!-- Counts sit BEFORE the icon so the icon itself never moves:
                     the numbers grow leftward into the empty title bar, while
                     the glyph stays anchored where the eye already found it,
                     and the caption buttons to its right are untouched.
                     Only shown while the active session is in a git repo. -->
                <Button x:Name="DiffButton" Style="{StaticResource BarChipButton}" Visibility="Collapsed"
                        AutomationProperties.Name="Changes" Click="OnDiffClick"
                        ToolTipService.ToolTip="Changes">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="DiffCounts" FontSize="11.5" Visibility="Collapsed"
                                   VerticalAlignment="Center">
                            <Run x:Name="DiffPlus" />
                            <Run x:Name="DiffMinus" />
                        </TextBlock>
                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xECF1;" FontSize="18" />
                    </StackPanel>
                </Button>
                <!-- Subtle tinted pill: red enough to notice, quiet enough to
                     live in the title bar without reading as an error. -->
                <Button x:Name="UpdateBadge" Visibility="Collapsed" Click="OnUpdateBadgeClick"
                        Height="22" MinWidth="0" Padding="10,0,10,1" CornerRadius="11"
                        BorderThickness="0" VerticalAlignment="Center" Margin="0,0,6,0"
                        Background="{ThemeResource UpdateBadgeBackground}"
                        Foreground="{ThemeResource UpdateBadgeForeground}">
                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Dark">
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3BE0524D" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F5B0AA" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4FE0524D" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F5B0AA" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2EC4433B" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#8F352F" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3EC4433B" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#8F352F" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" FontSize="11" />
                        <TextBlock Text="Update available" FontSize="11.5" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Custom caption buttons: they scale with the chrome zoom, unlike
                 the system-drawn ones (which is why those were replaced). -->
            <StackPanel x:Name="CaptionButtons" Grid.Column="5" Orientation="Horizontal"
                        VerticalAlignment="Stretch" SizeChanged="OnTitleBarSizeChanged">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"
                        AutomationProperties.Name="Minimize" ToolTipService.ToolTip="Minimize">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeClick"
                        AutomationProperties.Name="Maximize" ToolTipService.ToolTip="Maximize">
                    <FontIcon x:Name="MaximizeGlyph" FontFamily="Segoe Fluent Icons" Glyph="&#xE922;" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnCloseClick"
                        AutomationProperties.Name="Close" ToolTipService.ToolTip="Close">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B22A1B" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Content ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopStripRow" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sidebar (vertical tabs) -->
            <Grid x:Name="SidebarHost" Grid.RowSpan="2" Background="{ThemeResource PanelOverlayBrush}"
                  BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="6,6,6,3" ColumnSpacing="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="TabSearch" PlaceholderText="Search tabs..."
                                    FontSize="11"
                                    TextChanged="OnTabSearchTextChanged">
                        <AutoSuggestBox.QueryIcon>
                            <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xEB1C;" FontSize="14" Foreground="{ThemeResource BarIconBrush}" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <!-- Shown instead of the search box when tab search is off. -->
                    <TextBlock x:Name="SessionsLabel" Text="Sessions" Visibility="Collapsed"
                               FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{ThemeResource BarIconBrush}" />
                    <Button x:Name="NewTabButtonSidebar" Grid.Column="1" Style="{StaticResource SmallIconButton}"
                            ToolTipService.ToolTip="New session">
                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xEB0B;" FontSize="17" />
                    </Button>
                </Grid>

                <ListView x:Name="SessionList" Grid.Row="1" SelectionMode="Single"
                          ItemTemplate="{StaticResource SessionCardTemplate}"
                          SelectionChanged="OnSessionSelectionChanged"
>
                    <!-- Instant add/remove (no "reloading" flash), but a drag
                         that reorders tabs animates so the move reads. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <ReorderThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource RoundedListViewItem}">
                            <Setter Property="Margin" Value="4,1" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Sidebar footer: brand lockup (mark + wordmark) + running version -->
                <Grid Grid.Row="2" Padding="12,7,12,8"
                      BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Image Source="{ThemeResource ZharpLogoImage}" Height="15"
                               Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="zharp" FontFamily="{StaticResource ZharpBrandFont}"
                                   FontWeight="Medium" FontSize="12" CharacterSpacing="117"
                                   Foreground="{ThemeResource ZharpBrandForeground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SidebarVersionText" Grid.Column="1" FontSize="11"
                               Opacity="0.45" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Sidebar resize grip -->
            <controls:SidebarSplitter x:Name="SidebarResizer" Grid.RowSpan="2" Width="6"
                                      HorizontalAlignment="Right" Background="Transparent"
                                      PointerPressed="OnSplitterPressed"
                                      PointerMoved="OnSplitterMoved"
                                      PointerReleased="OnSplitterReleased"
                                      PointerCaptureLost="OnSplitterCaptureLost" />

            <!-- Top strip (horizontal tabs) -->
            <Grid x:Name="TopStripHost" Grid.Column="1" Grid.Row="0" Visibility="Collapsed"
                  BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="4"
                  Padding="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListView x:Name="SessionStrip" SelectionMode="Single"
                          ItemTemplate="{StaticResource SessionPillTemplate}"
                          SelectionChanged="OnSessionSelectionChanged"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <ReorderThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource RoundedListViewItem}">
                            <Setter Property="Margin" Value="2,4" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <Button x:Name="NewTabButtonStrip" Grid.Column="1" Style="{StaticResource SmallIconButton}"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="New session (Ctrl+Shift+T)">
                    <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xEB0B;" FontSize="17" />
                </Button>
            </Grid>

            <!-- Terminal area (settings pages render here; terminals overlay it).
                 TerminalHost is wrapped rather than placed directly so the diff
                 panel can take a share of the width: the terminal itself lives
                 in TerminalLayer and is positioned from TerminalHost's bounds,
                 so shrinking this element moves the terminal with it, with no
                 extra plumbing. -->
            <Grid x:Name="TerminalSplit" Grid.Column="1" Grid.Row="1" SizeChanged="OnTerminalSplitSizeChanged">
                <Grid.ColumnDefinitions>
                    <!-- MinWidth is the floor that stops a fixed-width diff
                         panel eating the terminal as the window narrows. The
                         panel is re-clamped on SizeChanged as well; this is
                         the guarantee, that is the tidy behaviour. -->
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition x:Name="DiffSplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="DiffColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="TerminalHost" Grid.Column="0" />

                <controls:SidebarSplitter x:Name="DiffResizer" Grid.Column="1" Visibility="Collapsed"
                                          Background="Transparent"
                                          PointerPressed="OnDiffSplitterPressed"
                                          PointerMoved="OnDiffSplitterMoved"
                                          PointerReleased="OnDiffSplitterReleased"
                                          PointerCaptureLost="OnDiffSplitterCaptureLost" />

                <Grid x:Name="DiffPanel" Grid.Column="2" Visibility="Collapsed"
                      Background="{ThemeResource ChromeWashBrush}"
                      BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1,0,0,0" />
            </Grid>

            <!-- Shown when every tab has been closed; the app stays open. -->
            <StackPanel x:Name="EmptyState" Grid.Column="1" Grid.Row="1" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <Image Source="{ThemeResource ZharpLogoImage}" Width="52" Height="52"
                       Opacity="0.85" HorizontalAlignment="Center" />
                <TextBlock Text="No open sessions" FontSize="13" Opacity="0.55"
                           HorizontalAlignment="Center" />
                <Button x:Name="EmptyStateNewTab" HorizontalAlignment="Center"
                        FontSize="13" Padding="14,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Style="{StaticResource TablerIcon}" Glyph="&#xEB0B;" FontSize="16" />
                        <TextBlock Text="New session" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- Untransformed layer hosting the active TerminalView in physical pixels.
         No background: empty areas stay click-through to the chrome below. -->
    <Grid x:Name="TerminalLayer" />

    <!-- Floating search palette. Lives above TerminalLayer; the transparent
         scrim catches click-away, the panel swallows its own taps. -->
    <Grid x:Name="SearchOverlay" Visibility="Collapsed" Background="Transparent"
          Tapped="OnSearchScrimTapped">
        <Grid.Resources>
            <!-- Outside Root, so the flat-input overrides must be repeated at
                 this element scope (app-level ones lose to XamlControlsResources). -->
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#26FFFFFF" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33FFFFFF" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4DFFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#26000000" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33000000" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4D000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.55*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.45*" />
        </Grid.RowDefinitions>
        <Border x:Name="SearchPanel" Grid.Row="1" Width="460" CornerRadius="10"
                Background="{ThemeResource FloatingPanelBrush}"
                BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1"
                Padding="10" Tapped="OnSearchPanelTapped">
            <StackPanel Spacing="8">
                <TextBox x:Name="SearchBox" PlaceholderText="Search sessions…" FontSize="13"
                         VerticalContentAlignment="Center"
                         TextChanged="OnSearchBoxTextChanged" KeyDown="OnSearchBoxKeyDown" />
                <ListView x:Name="SearchResults" MaxHeight="280" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="OnSearchResultClick">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource RoundedListViewItem}">
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SessionItem">
                            <Grid ColumnSpacing="10" Padding="2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource TablerIcon}" Glyph="{x:Bind IconGlyph}"
                                          FontSize="{x:Bind Z15, Mode=OneWay}" VerticalAlignment="Center"
                                          Foreground="{ThemeResource BarIconBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                           FontSize="{x:Bind Z13, Mode=OneWay}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <controls:TailTextBlock Grid.Column="2" Text="{x:Bind DisplaySubtitle, Mode=OneWay}"
                                                        FontSize="{x:Bind Z11, Mode=OneWay}" Opacity="0.55"
                                                        Width="{x:Bind Z170, Mode=OneWay}" AlignTrailing="True"
                                                        VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>

    <!-- First-run onboarding host (populated from code when not yet onboarded). -->
    <Grid x:Name="OnboardingOverlay" Visibility="Collapsed" Background="#66000000" />
    </Grid>
</Window>
