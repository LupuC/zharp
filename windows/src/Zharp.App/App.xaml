<Application
    x:Class="Zharp.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Zharp chrome colors per theme. "Light" is the Cream theme
                 (logo colors: charcoal on cream); "Dark" is the classic look. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ChromeWashBrush" Color="#F0282828" />
                    <SolidColorBrush x:Key="PanelOverlayBrush" Color="#28000000" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="IconChipBrush" Color="#1EFFFFFF" />
                    <SolidColorBrush x:Key="BarIconBrush" Color="#9EFFFFFF" />
                    <SolidColorBrush x:Key="SubtleIconBrush" Color="#70FFFFFF" />
                    <SolidColorBrush x:Key="SectionDividerBrush" Color="#1AFFFFFF" />
                    <!-- Opaque elevated surface for floating panels (search palette). -->
                    <SolidColorBrush x:Key="FloatingPanelBrush" Color="#FF303030" />
                    <!-- Flat input borders (element scopes reference these; overriding
                         the system TextControl* keys here is unreliable next to
                         XamlControlsResources, so windows apply them locally). -->
                    <SolidColorBrush x:Key="FlatInputBorderBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="FlatInputBorderBrushPointerOver" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="FlatInputBorderBrushFocused" Color="#4DFFFFFF" />
                    <!-- Brand mark, cream variant on dark surfaces. -->
                    <BitmapImage x:Key="ZharpLogoImage" UriSource="ms-appx:///Assets/logo-cream.png" />
                    <SolidColorBrush x:Key="ZharpBrandForeground" Color="#F0EFEC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ChromeWashBrush" Color="#F0EDE6D8" />
                    <SolidColorBrush x:Key="PanelOverlayBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#21000000" />
                    <SolidColorBrush x:Key="IconChipBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="BarIconBrush" Color="#9E2A2C33" />
                    <SolidColorBrush x:Key="SubtleIconBrush" Color="#703A3C40" />
                    <SolidColorBrush x:Key="SectionDividerBrush" Color="#20000000" />
                    <SolidColorBrush x:Key="FloatingPanelBrush" Color="#FFF7F2E8" />
                    <SolidColorBrush x:Key="FlatInputBorderBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="FlatInputBorderBrushPointerOver" Color="#33000000" />
                    <SolidColorBrush x:Key="FlatInputBorderBrushFocused" Color="#4D000000" />
                    <!-- Brand mark, ink variant on light surfaces. -->
                    <BitmapImage x:Key="ZharpLogoImage" UriSource="ms-appx:///Assets/logo-ink.png" />
                    <SolidColorBrush x:Key="ZharpBrandForeground" Color="#1A1A19" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Compact text inputs (theme-independent sizing). -->
            <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
            <Thickness x:Key="TextControlThemePadding">8,3,6,4</Thickness>

            <!-- Tabler Icons v3.46 (MIT) - https://tabler.io/icons -->
            <FontFamily x:Key="TablerIcons">ms-appx:///Assets/Fonts/tabler-icons.ttf#tabler-icons</FontFamily>
            <!-- Brand wordmark face: DM Mono Medium (OFL, bundled). -->
            <FontFamily x:Key="ZharpBrandFont">ms-appx:///Assets/Fonts/DMMono-Medium.ttf#DM Mono</FontFamily>
            <Style x:Key="TablerIcon" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource TablerIcons}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- List items whose hover/selection backplates honor CornerRadius.
                 The stock template's ListViewItemPresenter draws square backplates;
                 retemplating and passing CornerRadius through fixes that. -->
            <Style x:Key="RoundedListViewItem" TargetType="ListViewItem">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ListViewItemPresenter
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                SelectionCheckMarkVisualEnabled="False"
                                PointerOverBackground="{ThemeResource ListViewItemBackgroundPointerOver}"
                                PointerOverForeground="{ThemeResource ListViewItemForegroundPointerOver}"
                                SelectedBackground="{ThemeResource ListViewItemBackgroundSelected}"
                                SelectedForeground="{ThemeResource ListViewItemForegroundSelected}"
                                SelectedPointerOverBackground="{ThemeResource ListViewItemBackgroundSelectedPointerOver}"
                                PressedBackground="{ThemeResource ListViewItemBackgroundPressed}"
                                SelectedPressedBackground="{ThemeResource ListViewItemBackgroundSelectedPressed}"
                                FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}"
                                FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"
                                DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                ContentMargin="{TemplateBinding Padding}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
